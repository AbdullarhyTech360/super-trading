# Copy to `.env` before running the backend locally.
# `.env` is git-ignored; never commit real credentials.

ENVIRONMENT=development

# Allowed browser origins for CORS (JSON array form for pydantic-settings).
CORS_ORIGINS=["http://localhost:3000"]

